# Copy to .env and fill in real values. There is no mock/fallback mode —
# every key below is REQUIRED for the part of the system that uses it. A
# blank value makes the corresponding code raise MissingConfigurationError
# with this exact variable name the moment it's needed, rather than running
# on fake data. See README.md "No mock mode: what that actually means".

# --- LLM Provider (primary — the 5 monitoring agents, and the "Defender"
# voice in the debate stage) --- REQUIRED
# LLM_PROVIDER: "gemini" (default — calls the Gemini REST API directly, no
# extra SDK) or "anthropic" (uses the anthropic SDK; add it to
# requirements.txt if you switch).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# --- Debate "Challenger" voice (Phase 3) --- REQUIRED for the debate stage
# Deliberately a DIFFERENT provider from LLM_API_KEY above, so the
# adversarial review doesn't share the primary model's blind spots. Groq
# hosts open-weight models behind an OpenAI-compatible REST API — get a key
# at https://console.groq.com. Both this and LLM_API_KEY must be set for
# run_debate() to run at all — it raises immediately, naming whichever is
# missing, rather than running a one-voice review.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Web Search / News Provider --- REQUIRED for the 5 text-based
# monitoring agents to retrieve anything real. web_search.py is wired for
# a Tavily-style REST endpoint (https://api.tavily.com/search) — swap the
# URL/payload in src/tools/web_search.py if you're using a different
# provider.
WEB_SEARCH_API_KEY=

# --- YouTube (2026-09-16 addition) --- REQUIRED only for the YouTube Video
# Monitoring Agent (src/agents/monitoring_agent.py) to retrieve anything
# real; the other 5 agents never touch this key, so leaving it blank does
# not affect them. Free, official Google API, no billing account needed at
# this usage level (default quota is 10,000 units/day; one search call
# costs 100 units, and this agent makes one search per daily run).
#
# To get a key: console.cloud.google.com -> create or select a project ->
# APIs & Services -> Library -> enable "YouTube Data API v3" -> APIs &
# Services -> Credentials -> Create Credentials -> API key. Paste it below.
#
# A video's actual transcript is fetched separately by
# src/tools/youtube_transcript.py, which needs no key of its own — see that
# file's docstring for the honest caveat about what kind of API it is.
YOUTUBE_API_KEY=

# --- Rate / Cost Control ---
MAX_SEARCH_CALLS_PER_AGENT=5
MAX_PAGE_FETCHES_PER_AGENT=8
REQUEST_TIMEOUT_SECONDS=10

# How long a single uploaded-document analysis call (POST /documents/upload)
# is allowed to take before it's an honest failure. Deliberately longer than
# REQUEST_TIMEOUT_SECONDS above: a document sends far more text to the model
# and asks for more back than one news article's summary does, so it
# genuinely needs more time. 45 seconds is a reasonable default; raise it if
# you regularly upload long, multi-page documents and still see timeouts.
DOCUMENT_ANALYSIS_TIMEOUT_SECONDS=45

# How much completion room a single uploaded-document analysis call is
# allowed, separate from every other AI call's default cap. A document can
# describe several distinct events, each carrying a page/section reference
# on top of the usual fields, so the real response can be much longer than
# one news article's summary. If it's cut off at the cap, the response is
# truncated mid-JSON and the upload fails with nothing saved -- raise this
# if you regularly upload documents with many events and still see that.
DOCUMENT_ANALYSIS_MAX_OUTPUT_TOKENS=4000

# How large a single uploaded PDF (POST /documents/upload) is allowed to be,
# in bytes. Only limits the raw upload -- text extraction reads whatever
# pypdf can open regardless of size, and the extracted text sent to the AI
# is separately capped, so raising this does not change AI cost. 200 MB
# (209715200) covers a real multi-hundred-page or image-heavy PDF; raise it
# if you regularly work with larger files and see "File is too large".
DOCUMENT_UPLOAD_MAX_BYTES=209715200

# --- OCR for scanned PDFs (2026-09-25 addition) --- a scanned PDF (a photo
# or scan of pages, no real selectable text) previously always failed with
# "this system does not do OCR." It now runs real OCR automatically on any
# page that needs it (never on a normal, already-real-text PDF), using
# PyMuPDF (already in requirements.txt, pure pip install) plus Tesseract, a
# real, separate OCR program you install once:
#   Windows: download and run the installer at
#   https://github.com/UB-Mannheim/tesseract/wiki (the "UB-Mannheim" build
#   is the standard Windows one). During install, also check the boxes for
#   any additional language packs you need under "Additional language
#   data" -- French and Arabic, for Orchid Island's documents -- then set
#   OCR_LANGUAGES below to match. The installer adds Tesseract to PATH by
#   default; if OCR still reports it can't be found, set TESSERACT_CMD to
#   its full install path instead (see below).
#   Mac: `brew install tesseract tesseract-lang`
#   Linux: `apt install tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara`
#     (package names for the French/Arabic packs; adjust for your distro)
# Set to false to turn OCR off and go back to the original "does not do
# OCR" behavior (e.g. if Tesseract can't be installed on this machine).
OCR_ENABLED=true

# Full path to the real Tesseract binary. Leave blank to let pytesseract
# find it on PATH (what Tesseract's installer sets up by default). Set
# this only if OCR reports the binary can't be found -- Windows' default
# install location is typically:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Real Tesseract language pack(s) to read scanned pages with, "+"-joined.
# Defaults to English-only because that is the one pack always installed;
# a scanned French or Arabic page with only "eng" loaded will be misread,
# not rejected outright, so raise this the moment the matching language
# pack(s) above are installed too, e.g.:
# OCR_LANGUAGES=eng+fra+ara
OCR_LANGUAGES=eng

# How many of a document's real scanned pages get OCR'd, at most, in one
# upload -- OCR is slow (a real image-heavy multi-hundred-page scan can
# take minutes), and the upload endpoint is still a single request the
# browser waits on. Pages beyond this cap are left unread and reported as
# a real, honest limitation rather than silently dropped. Raise it if your
# machine is fast enough to wait longer for a bigger scan.
OCR_MAX_PAGES=50

# Rendering resolution (DPI) for turning each scanned page into an image
# before OCR. Higher improves accuracy on small/dense text at the cost of
# a slower render and OCR pass per page.
OCR_DPI=200

# --- Daily notifications (WhatsApp + email) --- OPTIONAL. Both channels are
# independent add-ons, not part of the core pipeline: if you leave these
# blank, POST /run-digest-and-notify and scripts/daily_notify.py still run
# the real pipeline and save the report exactly like POST /run-digest does
# -- they just report each channel as honestly "skipped_reason: ... not
# set" instead of sending it. There is no mock send: once you do fill
# these in, a real WhatsApp / Telegram message or real email goes out. See
# README.md "Daily automatic notifications (WhatsApp + Telegram + Email)"
# for full setup, including how to test connectivity (POST /notify/test)
# before trusting the daily schedule.

# WhatsApp -- two providers, chosen with WHATSAPP_PROVIDER (see
# src/services/whatsapp_notifier.py for the full comparison and the real
# "text-only, no media" constraint both share).
#
# Option A: callmebot.com (WHATSAPP_PROVIDER=callmebot) -- free for personal
# use, no monthly cost, no Meta Business verification. One-time opt-in per
# recipient: add the current bot number (published at
# https://www.callmebot.com/blog/free-api-whatsapp-messages/ -- it can
# change, so it isn't hardcoded here) as a WhatsApp contact, send it exactly
# "I allow callmebot to send me messages", then paste the API key it replies
# with into CALLMEBOT_API_KEY below.
#
# Option B: Twilio (WHATSAPP_PROVIDER=twilio) -- free WhatsApp Sandbox to
# start sending today, real per-message cost beyond that (Twilio's own
# pricing). Get a Sandbox at https://console.twilio.com.
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_API_KEY=
# Comma-separated recipient number(s) with country code, e.g.
# +212600000000. (Twilio's "whatsapp:+212..." format also still works if
# WHATSAPP_PROVIDER=twilio -- see whatsapp_notifier.py.)
WHATSAPP_TO_NUMBERS=
# Only needed if WHATSAPP_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio's own WhatsApp sender number, in Twilio's "whatsapp:+1..." format
# (their Sandbox number is whatsapp:+14155238886).
TWILIO_WHATSAPP_FROM=

# Telegram (2026-09-21 addition, src/services/telegram_notifier.py) -- free,
# one real provider, no business verification. Setup:
#   1. In Telegram, message @BotFather -> /newbot -> follow the prompts.
#      It replies with a token that looks like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#      -- paste it into TELEGRAM_BOT_TOKEN below.
#   2. Find your chat id: message @userinfobot (or your bot itself), or
#      open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates after
#      sending your bot any message -- it appears as "chat":{"id": ...}.
#   3. Each recipient (including you) must open a chat with your bot and
#      send it any message ONCE (e.g. "/start") before it can message them
#      -- this is a real Telegram rule (bots can't message first), not a
#      configuration step this system can skip.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat id(s), e.g. 111111111,-100222222222 (a "-100..." id
# is a group chat -- add the bot to the group and give it permission to post).
TELEGRAM_CHAT_IDS=

# Email, via plain SMTP (src/services/email_notifier.py) — works with any
# provider: Gmail (use an app password, not your normal password), Office
# 365, a company mail server, or a transactional service's SMTP relay
# (SendGrid, Mailgun, etc). This channel carries the real PDF attachment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Display name recipients see instead of the raw address, e.g. an inbox
# shows "Orchid Island - Intelligence Monitoring" rather than the bare
# Gmail address. Optional -- blank falls back to the address alone.
EMAIL_FROM_NAME=Orchid Island - Intelligence Monitoring
# Comma-separated recipient address(es), e.g.
# team@orchidisland.immo,manager@orchidisland.immo
EMAIL_TO=

# --- App ---
API_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Africa/Casablanca
